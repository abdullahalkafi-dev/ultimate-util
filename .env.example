# Copy to .env. Never commit .env.

# Used by docker compose (backend container talks to the mongo container):
MONGO_URI=mongodb://mongo:27017/ultimate-util?replicaSet=rs0
# Running the backend on your machine instead (pnpm dev:backend)? Use:
# MONGO_URI=mongodb://localhost:27017/ultimate-util?directConnection=true
# Atlas later: set ATLAS_URI=mongodb+srv://user:password@cluster/ultimate-util (docker compose then uses it instead of the local mongo)

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
NODE_ENV=development

# mock = built-in test login (development only). google = real Google OAuth.
AUTH_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APP_URL=http://localhost:3000
API_PORT=4000

# Host port for the web app (change it if 3000 is already used)
FRONTEND_PORT=3000
BACKEND_HOST_PORT=4000
