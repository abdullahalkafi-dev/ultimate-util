# Copy to .env for docker compose. Never commit .env.
MONGO_URI=mongodb://mongo:27017/ultimate-util?replicaSet=rs0
# For Atlas later: mongodb+srv://<user>:<password>@<cluster>/ultimate-util
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
AUTH_MODE=mock
# AUTH_MODE=google needs the two values below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000
API_PORT=4000
