{
  "name": "ultimate-util",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build:shared": "pnpm --filter @uu/shared build",
    "dev:backend": "pnpm --filter @uu/backend dev",
    "dev:frontend": "pnpm --filter @uu/frontend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "docker:up": "docker compose up -d --build",
    "docker:dev": "docker compose --profile dev up -d mongo mongo-express",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
